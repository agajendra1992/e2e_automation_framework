pipeline {
    agent any

    environment {
        JAVA17_HOME = '/usr/lib/jvm/java-17-openjdk-amd64'
    }

    stages {

        stage('Verify Java') {
            steps {
                sh '''
                    export JAVA_HOME=$JAVA17_HOME
                    export PATH=$JAVA_HOME/bin:$PATH

                    echo "JAVA_HOME=$JAVA_HOME"
                    java -version
                    javac -version
                    mvn -version
                '''
            }
        }

        stage('Maven Clean') {
            steps {
                dir('e2e') {
                    sh '''
                        export JAVA_HOME=$JAVA17_HOME
                        export PATH=$JAVA_HOME/bin:$PATH
                        mvn clean
                    '''
                }
            }
        }

         stage('Compile Tests') {
            steps {
                dir('e2e') {
                    sh '''
                        export JAVA_HOME=$JAVA17_HOME
                        export PATH=$JAVA_HOME/bin:$PATH
                        mvn compile
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('e2e') {
                    sh '''
                        export JAVA_HOME=$JAVA17_HOME
                        export PATH=$JAVA_HOME/bin:$PATH
                        mvn test
                    '''
                }
            }
        }

        stage('Test Results') {
            steps {
                dir('e2e') {
                    junit allowEmptyResults: true,
                          testResults: 'target/surefire-reports/*.xml'
                }
            }
        }
    }
}