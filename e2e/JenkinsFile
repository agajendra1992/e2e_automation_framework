pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Run Automation Tests') {
            steps {
                dir('e2e') {
                    sh 'mvn clean test'
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                dir('e2e') {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
    }
}